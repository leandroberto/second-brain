# Nada aqui é obrigatório. O Second Brain funciona 100% local sem variáveis.

# Vault padrão (senão: ~/.config/second-brain/config.json, senão ~/second-brain)
# BRAIN_VAULT=/home/voce/second-brain

# Porta da API/UI local (127.0.0.1)
# BRAIN_PORT=3737

# Nome do agente nos logs/auditoria (padrão: clientInfo.name do MCP)
# BRAIN_AGENT=claude-code

# Embeddings externos (OPT-IN: também exige embeddings.external_opt_in=true no config.yaml).
# Enviam título+corpo das notas ao endpoint configurado. Nunca commite a chave.
# OPENAI_API_KEY=
